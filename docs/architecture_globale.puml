@startuml Architecture_Globale_ARIA

' =========================================================================
'  ARIA - Adaptive Real-time IoT Analytics
'  Architecture globale - vue macroscopique par couches
'  Rapport PFE - Version finale
' =========================================================================

skinparam backgroundColor #FAFAFA
skinparam shadowing false
skinparam roundcorner 10
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 14
skinparam ArrowColor #37474F
skinparam ArrowThickness 1.5

skinparam rectangle {
    BorderColor #37474F
    FontStyle bold
    FontColor #1A1A1A
}

skinparam actor {
    BackgroundColor #ECEFF1
    BorderColor #455A64
}

title <b>ARIA - Architecture Globale</b>\n<size:12>Vue par couches</size>

actor "Utilisateur" as User

rectangle "Couche Presentation\n(Angular)" as L1 #E8F0FE
rectangle "Couche Backend Metier\n(Java / Quarkus)" as L2 #E0F2F1
rectangle "Couche Orchestration IA\n(FastAPI + Agent conversationnel)" as L3 #EDE7F6
rectangle "Couche Detection d'Anomalies\n(Machine Learning)" as L4 #FFF3E0
rectangle "Services IA Externes\n(fournisseurs LLM)" as L5 #F3E5F5
rectangle "Couche Persistance\n(MySQL)" as L6 #FBE9E7

User --> L1
L1 --> L2
L1 --> L3
L2 --> L6
L3 --> L4
L3 --> L5
L3 --> L6
L4 --> L6

@enduml
