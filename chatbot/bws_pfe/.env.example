# ── Base de données MySQL ──────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bw_samar
DB_USER=root
DB_PASSWORD=your_mysql_password

# ── API FastAPI ────────────────────────────────────────────────────────────────
API_PORT=8001
MCP_SERVER_URL=http://localhost:8000/sse
LOG_LEVEL=INFO
ENV=dev

# ── Backend LLM ────────────────────────────────────────────────────────────────
# Valeurs possibles : auto | cerebras | groq | gemini | openrouter | ollama | huggingface
# "auto" essaie dans l'ordre défini par LLM_ORDER
LLM_BACKEND=auto
LLM_ORDER=cerebras,openrouter,groq,gemini,ollama,huggingface

# ── Groq ───────────────────────────────────────────────────────────────────────
GROQ_API_KEY_1=gsk_your_key_here
# GROQ_API_KEY_2=gsk_second_key_optional
GROQ_MODEL_1=llama-3.3-70b-versatile
GROQ_MODEL_2=qwen/qwen3-32b
GROQ_MODEL_3=llama-3.1-8b-instant
GROQ_TEMPERATURE=0

# ── Gemini ─────────────────────────────────────────────────────────────────────
GEMINI_API_KEY_1=AIza_your_key_here
GEMINI_MODEL=gemini-2.0-flash

# ── Cerebras ───────────────────────────────────────────────────────────────────
CEREBRAS_API_KEY_1=csk_your_key_here
CEREBRAS_MODEL=gpt-oss-120b

# ── OpenRouter ─────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY_1=sk-or-v1-your_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ── Ollama (local) ─────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_1=qwen2.5:14b
OLLAMA_MODEL_2=qwen2.5:7b
OLLAMA_TIMEOUT=300

# ── HuggingFace ────────────────────────────────────────────────────────────────
HF_API_KEY_1=hf_your_key_here
HF_MODEL=Qwen/Qwen3-8B

# ── Vision (analyse d'images — nécessite un modèle multimodal Groq) ──────────
VISION_API_KEY_1=gsk_your_vision_key_here
VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ── AssemblyAI (transcription vocale) ─────────────────────────────────────────
ASSEMBLYAI_API_KEY=your_assemblyai_key_here

# ── CORS ───────────────────────────────────────────────────────────────────────
# Dev : * autorise toutes les origines
# Prod : lister les URLs exactes séparées par des virgules
CORS_ORIGINS=*
# CORS_ORIGINS=https://monapp.com,https://admin.monapp.com
